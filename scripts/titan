#!/usr/bin/env bash
set -e

case "$1" in
  health)
    scripts/titan-health.sh
    ;;
  build)
    npm run build
    ;;
  typecheck)
    npm run typecheck
    ;;
  status)
    git status --short
    ;;
  branch)
    git branch --show-current
    ;;
  verify)
    echo "VERIFY"
    find scripts -maxdepth 1 -type f | sed 's#scripts/##' | sort
    ;;
  *)
    echo "Titan commands:"
    echo "  titan health"
    echo "  titan build"
    echo "  titan typecheck"
    echo "  titan verify"
    echo "  titan status"
    echo "  titan branch"
    exit 1
    ;;
esac
