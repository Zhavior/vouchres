@import "tailwindcss";

@tailwind base;
@tailwind components;
@tailwind utilities;

:root {
  --obsidian-950: #020202;
  --obsidian-900: #050505;
  --obsidian-800: #0A0A0A;
  --vouch-emerald: #00FF94;
  --vouch-cyan: #00F0FF;
}

@layer base {
  body {
    @apply bg-[#050505] text-white antialiased selection:bg-[#00FF94]/30;
    font-family: 'Inter', system-ui, sans-serif;
  }
}

@layer components {
  .glass-panel {
    @apply bg-[#0A0A0A]/40 backdrop-blur-xl border border-white/10 shadow-[0_8px_32px_0_rgba(0,0,0,0.8)];
  }

  .terminal-text {
    @apply font-mono uppercase tracking-[0.2em] text-[10px] text-white/40;
  }

  .vouch-border {
    @apply border border-white/5 hover:border-[#00FF94]/30 transition-colors duration-500;
  }
}

/* Custom Scrollbar for the Terminal Look */
::-webkit-scrollbar {
  width: 4px;
}
::-webkit-scrollbar-track {
  background: #020202;
}
::-webkit-scrollbar-thumb {
  background: #1A1A1A;
  border-radius: 10px;
}
::-webkit-scrollbar-thumb:hover {
  background: #00FF94;
}
